{
  "name": "dental-care-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-01",

  "kv_namespaces": [
    { "binding": "RATE_LIMIT_KV", "id": "3bc8a00a962a490fb65c23903f5958ac" }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dental-care-bookings",
      "database_id": "fbf82af9-9984-4f55-a9e0-8c7b22689758"
    }
  ],

  "vars": {
    // Origins allowed to call this API (comma-separated, no trailing slash).
    "ALLOWED_ORIGINS": "http://localhost:3000,https://drmaria-dental-clinic.com"
  }

  // Secrets (set with `npx wrangler secret put <NAME>`):
  //   TURNSTILE_SECRET  TELEGRAM_BOT_TOKEN  TELEGRAM_CHAT_ID
}
